{
  "name": "amr-agent-skills-build",
  "version": "0.1.0",
  "description": "Build tooling for AMR Agent Skills",
  "type": "module",
  "scripts": {
    "build": "npx tsx src/build.ts --all",
    "build:skill": "npx tsx src/build.ts",
    "build-redis-code": "npx tsx src/build.ts --skill=redis-code",
    "build-azure-redis-infra": "npx tsx src/build.ts --skill=azure-redis-infra",
    "validate": "npx tsx src/validate.ts",
    "validate:skill": "npx tsx src/validate.ts",
    "dev": "npm run build && npm run validate"
  },
  "keywords": [
    "redis",
    "performance",
    "guidelines",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
