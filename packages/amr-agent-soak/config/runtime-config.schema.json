{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMR soak local runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscriptionId",
    "tenantId",
    "owner",
    "runId",
    "resourceGroup",
    "ackCustomerSubscription",
    "denylist",
    "subscriptionDenylist"
  ],
  "properties": {
    "subscriptionId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "resourceGroup": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "string", "minLength": 1 },
    "createPollTimeoutMs": { "type": "integer", "minimum": 1000 },
    "deletePollTimeoutMs": { "type": "integer", "minimum": 1000 },
    "ackCustomerSubscription": { "type": "boolean", "const": true },
    "denylist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "subscriptionDenylist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "killSwitchPath": { "type": "string" },
    "ledgerPath": { "type": "string" }
  }
}
