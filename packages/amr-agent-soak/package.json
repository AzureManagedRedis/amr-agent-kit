{
  "name": "amr-agent-soak",
  "version": "0.1.0",
  "private": true,
  "description": "Headless paired soak runner for AMR Agent Kit skill evaluations",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./executor": {
      "types": "./dist/src/executor/index.d.ts",
      "import": "./dist/src/executor/index.js"
    },
    "./integration": {
      "import": "./src/integration/index.mjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:core && npm run test:cache && npm run test:grading && npm run test:integration",
    "test:core": "node --test dist/test/core/*.test.js",
    "test:cache": "node --test test/cache/*.test.mjs",
    "test:grading": "node --test test/grading-report/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "preflight:integration": "node src/integration/preflight.mjs",
    "soak": "node dist/src/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
