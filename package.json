{
  "name": "amr-agent-kit",
  "displayName": "AMR Agent Kit",
  "private": true,
  "version": "0.1.0",
  "description": "Redis code and Azure Managed Redis infrastructure agent skills.",
  "keywords": [
    "redis",
    "azure",
    "azure-managed-redis",
    "managed-redis",
    "best-practices",
    "vector-search",
    "rag",
    "agent-skills"
  ],
  "author": {
    "name": "Microsoft",
    "url": "https://learn.microsoft.com/azure/redis/"
  },
  "license": "MIT",
  "repository": "https://github.com/AzureManagedRedis/amr-agent-kit",
  "homepage": "https://github.com/AzureManagedRedis/amr-agent-kit",
  "files": [
    "skills/",
    "docs/",
    "packages/amr-agent-skills-build/",
    "plugin.json",
    ".github/plugin/",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cd packages/amr-agent-skills-build && npm run build",
    "build:skill": "cd packages/amr-agent-skills-build && npx tsx src/build.ts",
    "validate": "npm run validate:skill && npm run validate:confidentiality",
    "validate:skill": "cd packages/amr-agent-skills-build && npx tsx src/validate.ts",
    "validate:confidentiality": "node scripts/check-confidentiality.mjs",
    "test": "npm run test:confidentiality && node --test scripts/docs-app.test.mjs scripts/generated-output.test.mjs scripts/plugin-marketplace.test.mjs",
    "test:confidentiality": "node --test scripts/check-confidentiality.test.mjs scripts/distribution-files.test.mjs",
    "dev": "cd packages/amr-agent-skills-build && npm run dev",
    "efficacy:prepare": "node scripts/prepare-efficacy-workspace.mjs"
  }
}
