{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained Soak Evaluation Run",
  "type": "object",
  "required": [
    "runId",
    "client",
    "scenario",
    "mode",
    "referenceGood",
    "bad",
    "withSkill",
    "withoutSkill",
    "patches",
    "hashes",
    "reproductionCommand",
    "report"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "client": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "offline",
        "live"
      ]
    },
    "referenceGood": {
      "const": "reference-good"
    },
    "bad": {
      "const": "bad"
    },
    "withSkill": {
      "const": "with-skill"
    },
    "withoutSkill": {
      "const": "without-skill"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^patches/.+\\.patch$"
      }
    },
    "hashes": {
      "const": "hashes.json"
    },
    "reproductionCommand": {
      "const": "reproduce.ps1"
    },
    "report": {
      "type": "string",
      "pattern": "^reports/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"
    }
  },
  "additionalProperties": false
}
